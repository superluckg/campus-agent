# 必填：填写你自己的外部服务凭据。
DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=

# DeepSeek 服务地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地单用户工作台，无需登录。
APP_ENV=local

# 本地数据库配置。密码为公开的本机体验默认值，可以自行覆盖。
# 已有数据库继续使用原来的密码，不要直接替换现有 .env。
POSTGRES_DB=qust_campus_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qust_local_dev
POSTGRES_HOST_PORT=15433

# Redis 与 Ollama 的本机访问端口。
REDIS_HOST_PORT=6380
OLLAMA_HOST_PORT=11435

# Docker 基础服务镜像。
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:8.10.1
OLLAMA_IMAGE=ollama/ollama:0.34.1
